# Python
__pycache__/
*.py[oc]
.uv/
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
venv/
.env
.env.*
!.env.example

# Berkas berat / biner. *.parquet termasuk deret IC harian
# (results/icseries_*.parquet) — regenerable dengan
# `PYTHONPATH=backend python backend/eval/rescore_all.py`.
*.pkl
*.h5
*.pt
*.ckpt
*.parquet
*.db
*.safetensors
*.bin
*.gguf

# Data pasar & model — diunduh saat setup, bukan di-commit (lihat README §2).
backend/hf_data/
backend/data/
.cache/
huggingface/

# Keluaran runtime.
# `llm/client.py` menulis snapshot output LLM ke ./debug/llm_outputs relatif cwd,
# dan pemanggilan lama meninggalkan direktori log per-run.
debug/
log/
backend/workspace/
backend/latent_runs/

# results/ DI-TRACK (probe Tahap 0, hasil bench & faktor menopang angka skripsi).
# Pengecualian per-jenis ada di results/.gitignore.

# Perkakas agen (lock/state lokal, bukan konfigurasi yang dibagikan)
.claude/

# IDE
.vscode/
.idea/
*.swp
.DS_Store
~
