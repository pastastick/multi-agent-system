# Data pasar & model — diunduh saat setup, bukan di-commit (lihat README §2).
backend/hf_data/
backend/data/
.cache/
huggingface/

# Keluaran runtime.
# `llm/client.py` menulis snapshot output LLM ke ./debug/llm_outputs relatif cwd,
# dan pemanggilan lama meninggalkan direktori log per-run.
debug/
log/
backend/workspace/
backend/latent_runs/

# results/ DI-TRACK (probe Tahap 0, hasil bench & faktor menopang angka skripsi).
# Pengecualian per-jenis ada di results/.gitignore.

# Perkakas agen (lock/state lokal, bukan konfigurasi yang dibagikan)
.claude/

# IDE
.vscode/
.idea/
*.swp
.DS_Store
~

# Hasil eksperimen — TIDAK di-track sejak 2026-08-27.
# Alasan: 181 MB dan terus tumbuh (probe/ 22M, factor/ 33M, bench/ 54M,
# ditambah llm_outputs/), sementara isinya artefak run yang dibaca lewat
# ringkasan di docs/ dan figur Bab IV — bukan sumber kode.
# Salinannya dikemas ke /workspace/hasil_results_lengkap_<stamp>.tar.gz
# (lihat scripts/kemas_hasil.sh). ARSIP ITU SATU-SATUNYA SALINAN begitu pod
# RunPod dihapus — scp keluar sebelum menghapus pod.
results/
